{
  "name": "oh-my-lsp-cli",
  "version": "0.1.0",
  "description": "TypeScript CLI scaffold with commander.js",
  "bin": {
    "oh-my-lsp": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "check": "tsc --noEmit"
  },
  "keywords": [
    "cli",
    "typescript",
    "commander"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.8.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
